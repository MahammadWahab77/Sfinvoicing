# ── API Security ──────────────────────────────
X_API_KEY=YOUR_X_API_KEY_HERE

# ── Google Drive / Docs ───────────────────────
# For local dev only — on Cloud Run leave this blank (uses attached service account)
GOOGLE_SERVICE_ACCOUNT_JSON=YOUR_GOOGLE_SERVICE_ACCOUNT_JSON_HERE

GOOGLE_TEMPLATE_FILE_ID=YOUR_GOOGLE_TEMPLATE_FILE_ID_HERE
GOOGLE_DOCS_FOLDER_ID=YOUR_GOOGLE_DOCS_FOLDER_ID_HERE
GOOGLE_PDFS_FOLDER_ID=YOUR_GOOGLE_PDFS_FOLDER_ID_HERE

# ── Salesforce ────────────────────────────────
SF_LOGIN_DOMAIN=YOUR_SF_LOGIN_DOMAIN_HERE
SF_API_VERSION=61.0
SF_CLIENT_ID=YOUR_SF_CLIENT_ID_HERE
SF_CLIENT_SECRET=YOUR_SF_CLIENT_SECRET_HERE
ENABLE_SALESFORCE_PATCH=false

# ── Webhook ───────────────────────────────────
INVOICE_WEBHOOK_URL=https://computing-ability-6555--devac.sandbox.my.salesforce-sites.com/services/apexrest/InvoiceWebhook
INVOICE_WEBHOOK_TIMEOUT_SECONDS=30
INVOICE_WEBHOOK_SECRET=YOUR_SHARED_WEBHOOK_SECRET_HERE
